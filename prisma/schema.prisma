// Калькулятор Лема — модель данных (раздел 8 ТЗ)
// Дерево сюжета хранится как граф на ссылках родитель-потомок,
// что позволяет сохранять альтернативные ветки и отклонённые волны.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Проект и его точка продолжения
model Project {
  id            String       @id
  name          String
  category      String? // закрепляется при первом выборе (FR-1.3)
  premise       String? // своя посылка автора (FR-1.4)
  provider      String? // провайдер, закреплённый за проектом (FR-9.5)
  model         String?
  currentNodeId String? // текущий узел — точка продолжения
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  nodes         PlotNode[]
  generations   Generation[]
}

// Развилки: выбранные, отклонённые, альтернативные
model PlotNode {
  id           String     @id
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       PlotNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     PlotNode[] @relation("NodeTree")
  level        Int        @default(0) // 0 = корень (категория), 1..12+ = развилки
  act          String     @default("Старт")
  title        String
  description  String     @default("")
  consequences String     @default("")
  tone         String? // dark | light | ironic | neutral
  tags         String     @default("[]") // JSON-массив строк
  isChosen     Boolean    @default(false) // у родителя не более одного isChosen
  isLem        Boolean    @default(false) // выбран в режиме Лема
  quip         String? // ироничная реплика, сопровождавшая выбор
  isFinal      Boolean    @default(false) // пометка «(конец)»
  generationId String? // волна, из которой пришла развилка
  editedByAuthor Boolean  @default(false) // текст переписан автором в окне «Редактировать» — высший приоритет в промпте
  createdAt    DateTime   @default(now())

  @@index([projectId])
  @@index([parentId])
}

// История запросов и прозрачность расходов
model Generation {
  id            String   @id
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  level         Int
  requestPrompt String
  rawResponse   String
  validated     Boolean  @default(false)
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  costUsd       Float    @default(0)
  provider      String
  model         String
  status        String   @default("ok") // ok | invalid | error
  errorText     String?
  quip          String? // ироничная реплика волны (режим Лема)
  createdAt     DateTime @default(now())

  @@index([projectId])
}

// Единственная строка настроек (id = 1)
model Setting {
  id          Int      @id @default(1)
  provider    String   @default("zai")
  model       String   @default("")
  temperature Float    @default(0.8)
  waveSize    Int      @default(7)
  lemPauseSec Int      @default(2)
  baseUrls    String   @default("{}") // JSON: { provider: baseUrl }
  onboarded   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// API-ключи провайдеров: только в шифрованном виде (NFR-1, FR-9.4)
model ProviderKey {
  provider  String   @id
  keyEnc    String
  updatedAt DateTime @updatedAt
}
